# ==============================================================
# AICTE Complaint Monitoring Dashboard — Backend Environment
# ==============================================================

PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB on port 27017 or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_complaints

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_token_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=aicte_auth_token

# Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# AI-Assisted Features (Optional: rule_based | gemini | openai)
AI_PROVIDER=rule_based
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
