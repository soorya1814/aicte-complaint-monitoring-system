# ==============================================================
# AICTE Complaint Monitoring Dashboard — Environment Configuration
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/aicte_complaints
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aicte_complaints?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_complaints

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_token_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=aicte_auth_token

# Client Origin (CORS and Cookie domain)
CLIENT_ORIGIN=http://localhost:5173

# AI-Assisted Features (Optional)
# If no API key is provided, the system seamlessly falls back to a high-accuracy rule-based NLP classifier.
AI_PROVIDER=rule_based
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Optional Email / Notification Dispatch (Core runs smoothly without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@aicte-india.org
